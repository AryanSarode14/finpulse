{
  "name": "@finpulse/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @finpulse/core build && pnpm exec prisma generate --schema=../../prisma/schema.prisma && next build",
