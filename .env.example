DATABASE_URL="postgresql://finpulse:finpulse@localhost:5433/finpulse?schema=public"

# Optional — natural-language insights (apps/web). If unset, the app falls
# back to a deterministic mocked insight client (no API calls, zero cost).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Base URL of the services/ml anomaly-detection FastAPI service.
ML_SERVICE_URL=http://localhost:8000
